package pages

import "com.xeubiart/app"
import "com.xeubiart/pages/gallery/frags"
import "com.xeubiart/utils"

func init(){
    app.GetInstance().Router.GET("/gallery", utils.Render(gallery()))
}

templ gallery(){
    {{
        result, _ := app.GetInstance().Services.GalleryService.GetGallery(0)
    }}

    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Xeubiart | Gallery</title>

        <link href="/tailwind.css" rel="stylesheet">

        <link rel="icon" type="image/x-icon" href="/static/svg/xeubiart.svg">

        <script type="module" src="/static/ui/ui-kit.mjs"></script>
        <link rel="stylesheet" href="/static/css/fontello.css">

        @head()
    </head>
    <body 
        x-data="gallery()"
        x-init="init()"
        class="min-h-[100dvh] h-fit bg-cream"
        :class="{ 'overflow-hidden': modalOpen }"
    >
        <ui-navbar></ui-navbar>
        <header class="px-8 lg:px-[10%] pt-10">
            <ui-eyebrow type="dash">Portifólio</ui-eyebrow>
            <ui-title level="h1" classes="text-[clamp(2.6rem,10vw,3.5rem)] [&_it]:[-webkit-text-stroke:1.5px_var(--color-cherry)]">Cada traço,<br> uma <it>história.</it></ui-title>
        </header>
        @frags.StyleSelector()

        <div class="px-8 lg:px-[10%]">
            <div
                x-ref="grid"
                id="gallery-grid"
                class="mx-auto"
            >
                for _, item := range result.Content {
                    @frags.ItemCard(item)
                }

                <template x-for="item in items" :key="item.id">
                    <article
                        class="gallery-item opacity-0 group cursor-pointer w-[150px] lg:w-[300px] mb-4 overflow-hidden rounded-2xl border border-cherry/20"
                        @click="openModal(item.id)"
                    >
                        <div class="relative">
                            <img
                                :src="`/api/files/${item.photos[0].url}`"
                                :alt="item.title"
                                class="block w-full h-auto group-hover:scale-[1.03] transition-transform duration-500 ease-out"
                            >
                            <div class="absolute inset-0 flex flex-col justify-end p-4 opacity-0 group-hover:opacity-100 transition-opacity duration-200 bg-gradient-to-t from-black/80 via-black/20 to-transparent">
                                <div class="text-white">
                                    <h2
                                        class="text-xl font-semibold"
                                        x-text="item.title"
                                    ></h2>
                                    <span
                                        class="text-sm opacity-70"
                                        x-text="item.style"
                                    ></span>
                                </div>
                            </div>
                        </div>
                    </article>
                </template>
            </div>

            <div x-ref="loader" class="h-10"></div>

            @frags.ItemCardModal()
        </div>

        <ui-footer></ui-footer>
    </body>
    </html> 
}

templ head(){
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/masonry-layout@4/dist/masonry.pkgd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/imagesloaded@5/imagesloaded.pkgd.min.js"></script>

    <style>
        @keyframes swipeHint {
            0%, 100% {
                transform: translate(-50%, -50%);
            }

            50% {
                transform: translate(-55%, -50%);
            }
        }
    </style>

    <script>
        function gallery() {
            return {
                selected: 'ALL',

                page: 1,
                items: [],
                loading: false,
                hasMore: true,
                masonry: null,
                observer: null,

                selectedWork: null,
                modalOpen: false,
                currentPhoto: 0,
                touchStartX: 0,
                touchStartY: 0,

                init() {
                    const grid = this.$refs.grid;

                    imagesLoaded(grid, () => {
                        this.masonry = new Masonry(grid, {
                            itemSelector: '.gallery-item',
                            columnWidth: window.innerWidth < 1024 ? 150 : 300,
                            gutter: 16,
                            fitWidth: true,
                            transitionDuration: 0,
                        });

                        requestAnimationFrame(() => {
                            grid.querySelectorAll('.gallery-item').forEach(item => {
                                item.classList.remove('opacity-0');
                            });
                        });

                        this.setupObserver();
                    });
                },

                async openModal(id) {
                    this.modalLoading = true;
                    this.modalOpen = true;
                    this.selectedWork = null;
                    this.currentPhoto = 0;

                    try {
                        const response = await fetch(`/api/works/${id}`);

                        if (!response.ok) {
                            throw new Error(
                                `Failed to fetch work: ${response.status}`
                            );
                        }

                        this.selectedWork = await response.json();

                        this.preloadPhoto(1);

                    } catch (error) {
                        console.error(error);
                        this.modalOpen = false;
                    } finally {
                        this.modalLoading = false;
                    }
                },

                closeModal() {
                    this.modalOpen = false;
                },

                previousPhoto() {
                    if (this.currentPhoto > 0) {
                        this.currentPhoto--;
                        this.preloadPhoto(this.currentPhoto - 1);
                    }
                },

                nextPhoto() {
                    if (
                        this.selectedWork &&
                        this.currentPhoto < this.selectedWork.photos.length - 1
                    ) {
                        this.currentPhoto++;
                        this.preloadPhoto(this.currentPhoto + 1);
                    }
                },

                preloadPhoto(index) {
                    if (
                        !this.selectedWork ||
                        index < 0 ||
                        index >= this.selectedWork.photos.length
                    ) {
                        return;
                    }

                    const image = new Image();
                    image.src = `/api/files/${this.selectedWork.photos[index].url}`;
                },

                async changeStyle(style) {
                    if (this.selected === style) {
                        return;
                    }

                    this.selected = style;

                    // Stop the current observer while we rebuild the gallery
                    this.observer?.disconnect();

                    this.loading = false;
                    this.hasMore = true;
                    this.page = 0;
                    this.items = [];

                    // Remove the SSR cards
                    this.masonry.remove(
                        this.$refs.grid.querySelectorAll('.gallery-item')
                    );

                    this.masonry.layout();

                    // Load the first page for the selected filter
                    await this.loadMore();

                    this.setupObserver();
                },

                setupObserver() {
                    this.observer = new IntersectionObserver(
                        entries => {
                            if (entries[0].isIntersecting) {
                                this.loadMore();
                            }
                        },
                        {
                            rootMargin: '300px'
                        }
                    );

                    this.observer.observe(this.$refs.loader);
                },

                async loadMore() {
                    if (this.loading || !this.hasMore) {
                        return;
                    }

                    this.loading = true;

                    try {
                        const params = new URLSearchParams({
                            page: this.page,
                            size: 12,
                        });

                        if (this.selected !== 'ALL') {
                            params.set('style', this.selected);
                        }

                        const response = await fetch(`/api/works?${params}`);

                        if (!response.ok) {
                            throw new Error(
                                `Failed to fetch gallery: ${response.status}`
                            );
                        }

                        const data = await response.json();

                        this.items.push(...data.content);
                        this.page++;
                        this.hasMore = this.page < data.totalPages;

                        await this.$nextTick();

                        const newItems = [
                            ...this.$refs.grid.querySelectorAll('.gallery-item')
                        ].slice(-data.content.length);

                        imagesLoaded(newItems, () => {
                            this.masonry.appended(newItems);
                            this.masonry.layout();

                            requestAnimationFrame(() => {
                                newItems.forEach(item => {
                                    item.classList.remove('opacity-0');
                                });
                            });
                        });

                    } catch (error) {
                        console.error(error);
                    } finally {
                        this.loading = false;
                    }
                }
            };
        }
    </script>
}