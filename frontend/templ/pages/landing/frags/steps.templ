package frags

import "fmt"

templ Steps(){
    <section-steps class="flex flex-col bg-cherry/10 px-15 lg:px-[10%] py-15 lg:py-20">
        // Header
        <div class="flex flex-col items-center mx-auto gap-5 max-w-[600px]">
            <ui-eyebrow type="sparkly">Como funciona</ui-eyebrow>
            <ui-title level="h4" classes="[font-size:clamp(2.2rem,6vw,3.4rem)] [line-height:1] text-center">Três passos para a tua <em>tatuagem do sonhos</em></ui-title>
            <p class="text-center text-muted max-w-[450px] lg:text-base text-sm/5">Do primeiro contacto à arte na pele — um processo simples, pensado para te fazer sentir bem em cada etapa.</p>
        </div>
        // Cards
        <div class="flex flex-col lg:flex-row gap-5 lg:gap-10">
            {{
                type cardData struct {
                    Emoji string
                    Title string
                    Text string
                }

                cards := []cardData{
                    {
                        Emoji: "🍒",
                        Title: "Vamos nos conhecer",
                        Text: "Me conta sua ideia, referências e o que essa tatuagem significa pra você. Quanto mais eu souber, melhor o resultado.",
                    },
                    {
                        Emoji: "✏️",
                        Title: "Criação do desenho",
                        Text: "Desenvolvo um projeto personalizado baseado na sua história. Você aprova, ajusta, e só então marcamos a sessão.",
                    },
                    {
                        Emoji: "🌟",
                        Title: "A mágica acontece",
                        Text: "Na sessão, cuidado, conforto e precisão do início ao fim. Você sai com uma obra de arte — e uma memória para sempre.",
                    },
                }
            }}

            for index, data := range(cards){
                <div class="bg-white p-8 rounded-2xl mt-10">
                    <div class="flex justify-between items-center">
                        <span class="bg-cherry/10 grid place-items-center w-[60px] aspect-square rounded-full text-2xl">{data.Emoji}</span>
                        <span class="text-cherry/10 text-[4rem] font-contrast">{fmt.Sprintf("%02d", index + 1)}</span>
                    </div>
                    <h6 class="text-cherry text-xl font-contrast mt-5 mb-3">{data.Title}</h6>
                    <p class="text-muted text-base/6">{data.Text}</p>
                </div>
            }
        </div>
    </section-steps>
}