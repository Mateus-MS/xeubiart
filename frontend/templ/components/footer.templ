package components

import "com.xeubiart/atoms"

type link struct {
    Label      string
    RedirectTo string
}

type linkGroup struct {
    Title string
    Links []link
}

type contact struct {
    Label      string
    RedirectTo string
    Icon       string
}

type FooterProps struct{
    IncludeCTA bool
}

templ Footer(props FooterProps){
    <footer class="
        w-full bg-black px-6 py-10 flex overflow-hidden relative

        before:block before:absolute before:w-[500px] before:h-[500px] before:rounded-full
        before:bg-[radial-gradient(circle,_rgba(139,26,43,0.32)_0%,_transparent_65%)]
        before:bottom-[-200px] before:left-[-200px] before:pointer-events-none before:z-0

        after:block after:absolute after:w-[500px] after:h-[500px] after:rounded-full
        after:bg-[radial-gradient(circle,_rgba(139,26,43,0.32)_0%,_transparent_65%)]
        after:top-[-200px] after:right-[-200px] after:pointer-events-none after:z-0
    ">
        <div class="w-full lg:max-w-[65%] ml-auto mr-auto flex gap-7 flex-col">
            <div>
                <a class="font-brand text-cherry text-5xl block mb-5" href="/">Xeubiart</a>
                <div class="text-muted text-sm">
                    <p>Arte feita com <em class="text-white/75 font-semibold">intenção</em> tatuada com cuidado.</p>
                    <p>Santo-Tirso, Porto - Portugal</p>
                </div>
            </div>

            @atoms.CherryDivider("")

            @linksHolder()

            @contactsHolder()

            if props.IncludeCTA {
                // @footerCTA()
            }

            // <footer-bottom class="flex flex-col lg:flex-row lg:justify-between gap-3 pt-7 border-t-cherry/50 border-1">
            //     <p class="text-muted text-xs text-center">© 2026 <strong class="text-cherry">Xeubiart</strong> — Todos os direitos reservados. Feito com <strong class="animate-pulse">🍒</strong> em Santo-Tirso - Porto.</p>

            //     <div class="text-white flex items-center justify-center gap-2">
            //         @atoms.Link(atoms.LinkProps{
            //             RedirectTo: "/legal/privacy",
            //             AditionalClassenames: "text-sm text-muted before:bg-muted font-normal",
            //         }){Privacidade}
            //         <span class="text-cherry text-sm">✦</span>
            //         @atoms.Link(atoms.LinkProps{
            //             RedirectTo: "/legal/terms",
            //             AditionalClassenames: "text-sm text-muted before:bg-muted font-normal",
            //         }){Termos}
            //         <span class="text-cherry text-sm">✦</span>
            //         @atoms.Link(atoms.LinkProps{
            //             RedirectTo: "/legal/cookies",
            //             AditionalClassenames: "text-sm text-muted before:bg-muted font-normal",
            //         }){Cookies}
            //     </div>
            // </footer-bottom>
        </div>
    </footer>
}

templ footerCTA(){
    <footer-cta class="w-full lg:justify-between flex flex-col lg:flex-row gap-6 items-center bg-cherry/10 border border-cherry/50 p-8 lg:px-12 rounded-2xl mt-4 mb-4">
        <div class="w-fit flex flex-col gap-4 items-center">
            @atoms.Eyebrown_Sparkly("text-cherry bg-cherry/25"){próxima sessão}
            @atoms.Title(atoms.TitleProps{
                Level: "h5",
                ClassNames: "text-white text-3xl text-center",
            }){ A tua pele merece<br> <em>arte de verdade.</em> }
            <p class="text-muted text-sm text-center">Agenda uma consulta gratuita — sem compromisso.</p>
        </div>
        <div>
            @atoms.Button_Heavy("", templ.Attributes{}){Marcar sessão <icon>&#xE80A;</icon>}
        </div>
    </footer-cta>
}

templ linksHolder(){
    {{
        data := []linkGroup{
            linkGroup{
                Title: "Estúdio",   
                Links: []link{
                    // link{
                    //     Label: "Sobre mim",
                    //     RedirectTo: "/about-me",
                    // },
                    link{
                        Label: "Portifólio",
                        RedirectTo: "/galery",
                    },
                    // link{
                    //     Label: "Estilos",
                    //     RedirectTo: "",
                    // },
                    // link{
                    //     Label: "Processo",
                    //     RedirectTo: "",
                    // },
                },
            },
            // linkGroup{
            //     Title: "Serviços",   
            //     Links: []link{
            //         link{
            //             Label: "Marcar sessão",
            //             RedirectTo: "/appointment",
            //         },
            //         link{
            //             Label: "Exclusivas do mês",
            //             RedirectTo: "",
            //         },
            //         link{
            //             Label: "Flash tattoos",
            //             RedirectTo: "",
            //         },
            //         link{
            //             Label: "Cursos",
            //             RedirectTo: "",
            //         },
            //     },
            // },
            linkGroup{
                Title: "Cuidados",   
                Links: []link{
                    // link{
                    //     Label: "Preparação",
                    //     RedirectTo: "",
                    // },
                    // link{
                    //     Label: "Cicatrização",
                    //     RedirectTo: "",
                    // },
                    // link{
                    //     Label: "Retoque grátis",
                    //     RedirectTo: "",
                    // },
                    link{
                        Label: "FAQ",
                        RedirectTo: "/faq",
                    },
                },
            },
            // linkGroup{
            //     Title: "Conta",   
            //     Links: []link{
            //         link{
            //             Label: "Entrar",
            //             RedirectTo: "/login",
            //         },
            //         link{
            //             Label: "Registrar",
            //             RedirectTo: "/register",
            //         },
            //     },
            // },
        }
    }}

    <links-holder class="grid lg:grid-cols-4 grid-cols-2 gap-6">
        for _, d := range(data){
            <ul>
                <h5 class="text-cherry mb-3 uppercase text-xs tracking-widest">{d.Title}</h5>
                for _, link := range(d.Links){
                    <li class="mb-2">
                        <a class="
                            ml-4 text-muted relative text-sm/1
                            transition-colors before:transition-opacity
                            before:opacity-0 before:absolute before:left-[-15px] before:top-1/2 before:-translate-y-1/2 before:w-[7px] before:aspect-square before:bg-cherry before:rounded-full
                            hover:before:opacity-100 hover:text-white
                        " href={link.RedirectTo}>{link.Label}</a>
                    </li>
                }
            </ul>
        }
    </links-holder>
}

templ contactsHolder(){
    {{
        data := []contact{
            contact{
                Label:      "xeubiart_",
                RedirectTo: "https://www.instagram.com/xeubiart_/",
                Icon:       "\uF16D",
            },
            contact{
                Label:      "xeubiart",
                RedirectTo: "https://www.tiktok.com/@xeubiart",
                Icon:       "\uE81A",
            },
            contact{
                Label:      "xeubiart",
                RedirectTo: "https://www.facebook.com/xeubiart.comercial",
                Icon:       "\uF09A",
            },
            contact{
                Label:      "hi@xeubiart.com",
                RedirectTo: "mailto:hi@xeubiart.com",
                Icon:       "\uE803",
            },
            contact{
                Label:      "+351 910 338 381",
                RedirectTo: "https://wa.me/351910338381",
                Icon:       "\uF232",
            },
        }
    }}
    <contact-methods>
        <h5 class="text-cherry mb-3 uppercase text-xs tracking-widest">Redes & contato</h5>

        <contact-wrapper class="flex gap-3 flex-wrap">
            for _, contact := range(data) {
                <a class="
                    border-cherry/75 border text-muted rounded-full px-4 py-2 text-sm/4 flex items-center w-fit gap-2
                    transition-colors duration-350
                    hover:bg-cherry/15 hover:border-cherry
                " href={contact.RedirectTo}>
                    <icon>{contact.Icon}</icon>
                    <span>{contact.Label}</span>
                </a>
            }
        </contact-wrapper>
    </contact-methods>
}