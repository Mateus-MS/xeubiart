package templates

type BaseProps struct{
    HeadTitle   string
    HeadImports templ.Component

    IncludeNavigation bool
    IncludeFooter     bool
    IncludeFooterCTA  bool

    AditionalClasses string
}

templ Base(props BaseProps){
	<!DOCTYPE html>
    <html lang="en" class={props.AditionalClasses}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{props.HeadTitle}</title>

        <link href="/tailwind.css" rel="stylesheet">

        <link rel="icon" type="image/x-icon" href="/static/svg/xeubiart.svg">

        <script type="module" src="/static/ui/ui-kit.mjs"></script>

        @props.HeadImports
    </head>
    <body class="min-h-[100dvh] h-fit">
        if props.IncludeNavigation {
            <ui-navbar></ui-navbar>
        }

        { children... }

        if props.IncludeFooter {
            <ui-footer></ui-footer>
        }

        if props.IncludeNavigation {
            <ui-hotbar></ui-hotbar>
        }
    </body>
    </html>    
}