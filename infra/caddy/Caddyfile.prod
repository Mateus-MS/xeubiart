{
    auto_https off
}

:80 {
    # Shared UI library bundle
    handle_path /static/ui/* {
        root * /app/ui/dist
        file_server
    }

    # Static assets (images, fonts, etc.)
    handle_path /static/* {
        root * /app/static
        file_server
    }

    # Tailwind CSS bundle
    @tailwind {
        path /tailwind.css
    }
    handle @tailwind {
        root * /app/tailwind/dist
        file_server
    }

    # Backend API / Templ routes
    @templ {
        method GET
        path /
        not query token=*
    }
    handle @templ {
        reverse_proxy templ:8081
    }

    # Fallback: Serve the pre-compiled Angular SPA static files
    handle {
        root * /app/angular
        file_server
        try_files {path} /index.html
    }
}