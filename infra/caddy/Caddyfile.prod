{
    auto_https off
}

:80 {
    # Shared UI library bundle
    handle_path /static/ui/* {
        root * /app/ui/dist
        file_server
    }

    # Static assets (css, fonts)
    handle_path /static/* {
        root * /app/static
        file_server
    }

    @tailwind {
        path /tailwind.css
    }

    handle @tailwind {
        root * /app/tailwind/dist
        file_server
    }

    @templ {
        method GET
        path /
        not header Upgrade *websocket*
        not query token=*
    }
    handle @templ {
        reverse_proxy templ:8081
    }

    # Serve Compiled Angular Static Files with SPA Fallback
    handle {
        root * /app/angular
        try_files {path} /index.html
        file_server
    }
}