{
    auto_https off
}

:80 {
    # Shared UI library bundle
    handle_path /static/ui/* {
        root * ../frontend/ui/dist
        file_server
    }

    # Reverse proxy Angular WebSocket requests
    @angular_ws {
        header Connection *Upgrade*
        header Upgrade    websocket
    }
    reverse_proxy @angular_ws localhost:4200

    @tailwind {
        path /tailwind.css
    }

    handle @tailwind {
        root * ../frontend/tailwind/dist
        file_server
    }

    @templ {
        path / /static*
    }

    reverse_proxy @templ localhost:8081

    reverse_proxy localhost:4200
}